# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าให้ตรงกับเครื่องของคุณ (ห้ามอัปโหลด .env ขึ้น GitHub)

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=ใส่รหัสผ่าน_PostgreSQL_ของคุณ
DB_NAME=rice_harvester_db

# (ตอน deploy) ถ้าฐานข้อมูลออนไลน์ให้ลิงก์เชื่อมต่อมา ใส่ที่นี่แทนค่า DB_* ด้านบน
# DATABASE_URL=postgres://user:password@host:5432/dbname
# DB_SSL=1

# --- Server ---
PORT=5000
CORS_ORIGIN=http://localhost:5173
# (ตอน deploy หลัง nginx) ตั้งเป็น 1
# TRUST_PROXY=1

# สตริงสุ่มยาว ๆ ใช้เซ็นชื่อ token ตอนล็อกอิน (อย่างน้อย 16 ตัวอักษร)
# สร้างได้ด้วย: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=เปลี่ยนเป็นสตริงสุ่มยาวๆ_อย่างน้อย_16_ตัว

# --- บัญชีเจ้าของกิจการเริ่มต้น (ใช้ตอนรัน npm run db:init) ---
OWNER_USERNAME=owner
OWNER_PASSWORD=ตั้งรหัสผ่าน_อย่างน้อย_8_ตัว

# --- LINE Official Account (ไม่บังคับ ใส่เมื่อจะใช้เมนู "แชต LINE") ---
# Channel secret และ Channel access token (long-lived) จาก LINE Developers Console
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
